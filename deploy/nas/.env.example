# Copy to /volume1/docker/draftsmith/.env on the NAS. Never commit the real file.

# Review repo (private, on the NAS Gitea): draft branches + PRs go here.
REPO_URL=http://192.168.1.134:3001/pokepitchshop/draftsmith.git
FORGE=gitea
# Gitea token (scope write:repository) for the repo owner.
FORGE_TOKEN=

# Code source: GitHub main is synced into the Gitea main before each job
# (fast-forward or merge; never force). Public repo, so no token needed.
UPSTREAM_URL=https://github.com/pokepitchshop/Draftsmith.git

# Optional: GitHub token, only to raise API rate limits when ingesting github.com links.
GITHUB_TOKEN=

# Ollama on the Windows GPU box (shared with Home Assistant + sdvosb-app)
OLLAMA_HOST=http://192.168.1.12:11434

POLL_SECONDS=15

# 1 = commit locally in work/repo only (no push, no PR).
DRY_RUN=0
